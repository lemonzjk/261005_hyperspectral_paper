  "findings": {
    "nonlocal-tucker-denoising-jstars-2018": {
      "summary": "以非局部全谱块组的第三阶非负Tucker和HALS去噪，聚合后迭代反馈；Columbia与三传感器影像均加人工Gaussian评估，原图当GT。",
      "mechanism": "6×6全谱块展平36×Is，取50非局部相似块堆36×Is×50第三阶张量；HALS逐因子列/核心更新、AIC/MDL秩及delta=.1反馈。Eq10正交约束与后文非负更新、Eq16/17投影下限及Eq19求和不一致，保留原式待正式/代码。",
      "datasets": "Columbia32场景512×512×31/400–700nm；AM Indian145×145×224、Pavia610×340×103、Washington原1028×307×210用300×300×190。224/190与原库220/191版本差异分列，不借别稿改数。",
      "experimentSetting": "人工零均值Gaussian sigma10–60；Columbia表20/40/60，另三表20/30/40/50；逐带PSNR/SSIM/FSIM平均，七基线。patch6、K50、窗30²–80²、delta=.1，具体秩/L/归一/seed/重复/运行时间未给。",
      "conclusions": "四主表45指标列Ours高于所有可读基线值，但Washington一SSIM原印0716未猜值；Columbia PSNR42.87/39.85/36.26。与ICIP2017全81表值一致，TDL换SPA+LR且张量/带数不同，关系与结果来源待；不称独立复现或统计显著。",
      "limitations": "AM11页无封面全读，正式JSTARS11(3):701–712未独立读。Eq10正交/非负、Eq16/17下限、Eq19索引/系数、核心正性/归一、算法首步Eq7指错、秩/L/初始化/停止/复杂度及窗口表差异待代码/正式核；原库、原生噪声泛化及运行时间未证。"
    },
    "tensor-morphological-profile-icip-2016": {
      "summary": "把高光谱行/列/波段作为张量域，以同阶结构元素的标量形态学开闭构建TMP，再用线性SVM分类；区别PCA二维EMP和低秩Tucker。",
      "mechanism": "张量体素标量邻域min/max、开闭和多尺度剖面，3D圆柱SE融合空间/波段索引；radius1/3/5/7、height3/5/9/17。整数阈值截面提供解释，无谱向量排序、低秩因素或物理三维重建。",
      "datasets": "Pavia ROSIS103带/.43–.86µm/1.3m/9类、已有训练测试样本；IndianPines AVIRIS200带（删20水吸收）/20m/16类，每类随机5%训练、余测试。本文未印两场景空间规模或实际split编号。",
      "experimentSetting": "SPE/EMP/TMP三特征配linear SVM；EMP用PCA/disk，TMP用cylinder；radius-height配对、EMP分量p、C/归一/边界、seed/重复/std未给。Table1两组按图注与正文顺序推断，18值原精度保存。",
      "conclusions": "TMP OA两组90.2/88.6，较EMP86.4/83.2高3.8/5.4个百分点；AA86.7/87.4、kappa.87/.87。无显著性检验或空间隔离测试，不推广MRI/video。三图皆输入/特征/分类展示，无独立完整框架图。",
      "limitations": "AM6页（封面1/正文参考5）全读；正式ICIP2016:2197–2201未独立读。Eq9域维记号、Eq12整数强度条件/连续谱量化、SE对称/配对/边界、全部分类参数与划分仍待；Fig3图注重复Pavia而正文为两场景，原注保留。"
