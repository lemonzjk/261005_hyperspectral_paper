  "method": {
    "input": "原HSI template/search、首帧bbox；学习投影对接冻结OSTrack，不将FCI RGB基线当本方法完整输入。",
    "unmixing": "线性混合形式X=MA+E；AE encoder估丰度A、decoder重构X，支持DAEU/CNNAEU，后者默认；r=6。原文称非负/和一，但未见具体约束实现和物理真值。",
    "amd": "A经1×1 Conv变成2c=6学习通道，c=3；在相邻学习通道上1D Haar和/差得到3通道低/高支路，不是原始波长轴小波。",
    "wmp": "每支路材料prompt与主干特征做空间2D Haar，LL跨注意力，HL/LH/HH拼接后1×1/group3×3 conv/BN/LeakyReLU/1×1并IHaar。",
    "fusion": "低/高prompt拼接经降维-中层残差-升维，再残差注入冻结主干；默认层1,2,4,6,8,10,12。",
    "prediction": "OSTrack式分类、offset/scale三头，各5层Conv-BN-ReLU加1×1；Fig2图例预测头冻结，正文只明说冻结主干/优化新增模块，确切冻结范围待实现。",
    "losses": {
      "tracking": "focal + 2*GIoU + 5*L1",
      "reconstruction": "SAD+MSE",
      "targetMask": "search mask由主干candidate elimination scores产生；V=0 target相关，V=1背景，不是额外像素级材料/分割真值。",
      "unmixing": "template完整Lrec + (1-λce)*target-masked search Lrec + λce*background-masked search Lrec；默认λce=.2即target .8、background .2。",
      "joint": "(1-λu)*Ltracking+λu*Lunmixing，λu=.5；λu=1移除跟踪监督，λu=0只剩通用prompt生成。",
      "implementationBoundary": "掩码置零后的SAD及reduce/mask大小归一、掩码阈值与梯度未明，不能由公式推断可直接运行。"
    }
  },
