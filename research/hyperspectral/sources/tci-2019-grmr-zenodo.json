{"created": "2018-10-10T12:10:23.567598+00:00", "modified": "2024-08-02T02:55:50.196476+00:00", "id": 1454088, "conceptrecid": "1454087", "doi": "10.5281/zenodo.1454088", "conceptdoi": "10.5281/zenodo.1454087", "doi_url": "https://doi.org/10.5281/zenodo.1454088", "metadata": {"title": "Graph and Rank Regularized Matrix Recovery for Snapshot Spectral Image Demosaicing", "doi": "10.5281/zenodo.1454088", "publication_date": "2018-10-10", "description": "<p>Snapshot Spectral Imaging (SSI) is a cutting-edge&nbsp;technology for enabling the efficient acquisition of the spatiospectral&nbsp;content of dynamic scenes using miniaturized platforms.&nbsp;To achieve this goal, SSI architectures associate each spatial&nbsp;pixel with a specific spectral band, thus introducing a critical&nbsp;trade-off between spatial and spectral resolution. In this paper,&nbsp;we propose a computational approach for the recovery of high&nbsp;spatial and spectral resolution content from a single or a small&nbsp;number of exposures. We formulate the problem in a novel&nbsp;framework of spectral measurement matrix completion and we&nbsp;develop an efficient low-rank and graph regularized method&nbsp;for SSI demosaicing. Furthermore, we extend state-of-the-art&nbsp;approaches by considering more realistic sampling paradigms&nbsp;that incorporate information related to the spectral profile&nbsp;associated with each pixel. In addition to reconstruction quality,<br>\nwe also investigate the impact of recovery on subsequent analysis&nbsp;tasks like classification using state-of-the-art convolutional neural<br>\nnetworks. We experimentally validate the merits of the proposed&nbsp;recovery scheme using synthetically generated data from indoor<br>\nand satellite observations and real data obtained with an IMEC&nbsp;visible range SSI camera.</p>", "access_right": "open", "creators": [{"name": "Grigorios Tsagkatakis", "affiliation": "ICS - FORTH"}, {"name": "Maarten Bloemen", "affiliation": "IMEC"}, {"name": "Bert Geelen", "affiliation": "IMEC"}, {"name": "Murali Jayapala", "affiliation": "IMEC"}, {"name": "Panagiotis Tsakalides", "affiliation": "ICS - FORTH"}], "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "640174", "internal_id": "10.13039/501100000780::640174", "funder": {"name": "European Commission", "doi": "10.13039/501100000780", "acronym": "EC"}, "title": "Sparse Signal Processing Technologies for HyperSpectral Imaging Systems", "acronym": "PHySIS", "program": "H2020-EU.2.1.6.", "url": "https://cordis.europa.eu/projects/640174"}], "communities": [{"id": "eu"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1454087"}}]}}, "title": "Graph and Rank Regularized Matrix Recovery for Snapshot Spectral Image Demosaicing", "links": {"self": "https://zenodo.org/api/records/1454088", "self_html": "https://zenodo.org/records/1454088", "preview_html": "https://zenodo.org/records/1454088?preview=1", "doi": "https://doi.org/10.5281/zenodo.1454088", "self_doi": "https://doi.org/10.5281/zenodo.1454088", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1454088", "reserve_doi": "https://zenodo.org/api/records/1454088/draft/pids/doi", "parent": "https://zenodo.org/api/records/1454087", "parent_html": "https://zenodo.org/records/1454087", "parent_doi": "https://doi.org/10.5281/zenodo.1454087", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1454087", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1454088/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1454088/sequence/default", "files": "https://zenodo.org/api/records/1454088/files", "media_files": "https://zenodo.org/api/records/1454088/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:1454088:Tsagkatakis_TCI_2018.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:1454088:Tsagkatakis_TCI_2018.p