_mandatory": false}, {"name": "Cultural Warning", "value": "", "settings": {"validations": {"min_length": 161, "max_length": 161}, "placeholder": "Cultural Warning"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Acceptance Date", "value": "2018-06-11", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "Author Research Institute", "value": "", "settings": {"options": ["Appleton Institute", "Centre for Intelligent Systems", "Centre for Railway Engineering", "Centre for Regional Advancement of Learning, Equity, Access and Participation (LEAP)", "Centre for Indigenous Health Equity Research", "Centre for Tourism and Regional Opportunities", "Centre for Research in Equity and Advancement of Teaching & Education (CREATE)", "Coastal Marine Ecosystems Research Centre (CMERC)", "Institute for Future Farming Systems", "Queensland Centre for Domestic and Family Violence", "Centre for Regional Economics and Supply Chain (RESC)"], "placeholder": "Author Research Institute", "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Era Eligible", "value": ["Yes"], "settings": {"options": ["Yes", "No"], "placeholder": "Era Eligible", "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Medium", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Medium"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Parent Title", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 5000}, "placeholder": "Parent Title"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Journal", "value": "Computers and Electronics in Agriculture", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Journal"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Article Number", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Article Number"}, "field_type": "text", "order": null, "is_mandatory": false}], "figshare_url": "https://acquire.cqu.edu.au/articles/journal_contribution/A_non-destructive_determination_of_peroxide_values_total_nitrogen_and_mineral_nutrients_in_an_edible_tree_nut_using_hyperspectral_imaging/13448585", "download_disabled": false, "description": "Nuts are nutritionally valuable for a healthy diet but can be prone to rancidity due to their high unsaturated fat content. Nutrient content of nuts is an important component of their health benefits but measuring both rancidity and nutrient content of nuts is laborious, tedious and expensive. Hyperspectral imaging has been used to predict chemical composition of plant parts. This technique has the potential to rapidly predict chemical composition of nuts, including rancidity. Hence, this study explored to what extent hyperspectral imaging (400\u20131000 nm) could predict chemical components of Canarium indicum nuts. Partial least squares regression (PLSR) models were developed to predict kernel rancidity using peroxide value (PV) for two different batches of kernels, and macro- and micronutrients of kernels using the spectra of the samples obtained from hyperspectral images. The models provided acceptable prediction abilities with strong coefficients of determination (R2) and ratios of prediction to deviation (RPD) of the test set for PV, first batch (R2 = 0.72; RPD = 1.66), PV, second batch (R2 = 0.81; RPD = 2.30), total nitrogen (R2 = 0.80; RPD = 1.58), iron (R2 = 0.75; RPD = 1.46), potassium (R2 = 0.51; RPD = 0.94), magnesium (R2 = 0.81; RPD = 2.04), manganese (R2 = 0.71; RPD = 1.84), sulphur (R2 = 0.76; RPD = 1.84) and zinc (R2 = 0.62; RPD = 1.37) using selected wavelengths. This study indicated that visible-near infrared (VNIR) hyperspectral imaging has the potential to be used for prediction of chemical components of C. indicum nuts without the need for destructive analysis. This technique has potential to be used to predict chemical components in other nuts. \u00a9 2018 Elsevier B.V.", "funding": "Category 1 - Australian Competitive Grants (this includes ARC, NHMRC)", "funding_list": [{"id": 19539629, "title": "Category 1 - Australian Competitive Grants (this includes ARC, NHMRC)", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 0, "created_date": "2021-01-17T10:04:34Z", "modified_date": "2021-01-17T10:04:36Z", "is_public": true, "is_confidential": false, "is_metadata_record": true, "confidential_reason": "", "metadata_reason": "", "license": {"value": 105, "name": "CQUniversity General 1.0", "url": "https://libguides.library.cqu.edu.au/acquirelicences/general1"}, "tags": ["Canarium indicum (Burseraceae)", "Crude protein", "Macro and micro-nutrients", "Visible-near infrared (VNIR) hyperspectral ranges", "Rancidity", "Horticultural Production not elsewhere classified"], "keywords": ["Canarium indicum (Burseraceae)", "Crude protein", "Macro and micro-nutrients", "Visible-near infrared (VNIR) hyperspectral ranges", "Rancidity", "Horticultural Production not elsewhere classified"], "categories": [{"id": 24073, "title": "Horticultural production not elsewhere classified", "parent_id": 24052, "path": "/23812/24052/24073", "source_id": "300899", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Bai, SH; Tahmasbian, I; Zhou, J; Nevenimo, T; Hannet, G; Walton, D; et al. (2018). A non-destructive determination of peroxide values, total nitrogen and mineral nutrients in an edible tree nut using hyperspectral imaging. CQUniversity. Journal contribution. https://hdl.handle.net/10018/1260203", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 13448585, "title": "A non-destructive determination of peroxide values, total nitrogen and mi