    {
      "id": "dsc-crossmodal",
      "shortTitle": "DSC",
      "title": "Deep Self-correlation Descriptor for Dense Cross-Modal Correspondence",
      "authors": "Seungryong Kim, Dongbo Min, Stephen Lin, Kwanghoon Sohn",
      "year": 2016,
      "venue": "ECCV",
      "track": "registration",
      "representation": "跨光谱稠密对应描述子",
